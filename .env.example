# PostgreSQL (único serviço no Docker)
POSTGRES_DB=terzo
POSTGRES_USER=terzo
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5432

# Processos PM2
WEB_PORT=3000
API_PORT=3001
API_HOST=127.0.0.1
DATABASE_URL=postgresql://terzo:troque_esta_senha@127.0.0.1:5432/terzo?schema=public
DATA_DIR=./data
COOKIE_SECURE=true
TRUST_PROXY=1
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7
MAX_UPLOAD_MB=25

# Nextcloud via WebDAV. Use uma senha de aplicativo, não a senha principal.
NEXTCLOUD_ENABLED=false
NEXTCLOUD_URL=https://cloud.exemplo.com
NEXTCLOUD_USERNAME=usuario
# Opcional quando for igual ao username; útil para logins OIDC/e-mail.
NEXTCLOUD_USER_ID=usuario
NEXTCLOUD_APP_PASSWORD=cole_a_senha_de_aplicativo_aqui
NEXTCLOUD_BASE_PATH=Terzo
NEXTCLOUD_SYSTEM_FOLDER=TERCEIRO ANDAR
NEXTCLOUD_READ_TIMEOUT_MS=120000
NEXTCLOUD_WRITE_TIMEOUT_MS=30000
NEXTCLOUD_HEALTH_TIMEOUT_MS=10000
NEXTCLOUD_RETRIES=2
NEXTCLOUD_RECONCILE_INTERVAL_MINUTES=30

# Next → API local
API_INTERNAL_URL=http://localhost:3001

# Opcional: lista separada por vírgulas
# ALLOWED_MIME=image/png,image/jpeg,application/pdf

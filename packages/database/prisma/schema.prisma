generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id
  username       String    @unique
  name           String
  email          String    @default("")
  passHash       String    @map("pass_hash")
  role           String    @default("member")
  status         String    @default("active")
  mustChange     Boolean   @default(true) @map("must_change")
  sessionVersion Int       @default(1) @map("session_version")
  createdAt      BigInt    @map("created_at")
  lastLogin      BigInt?   @map("last_login")
  memberId       String    @default("") @map("member_id")
  sessions       Session[]

  @@map("users")
}

model Session {
  idHash    String @id @map("id_hash")
  userId    String @map("user_id")
  ver       Int
  createdAt BigInt @map("created_at")
  lastSeen  BigInt @map("last_seen")
  expiresAt BigInt @map("expires_at")
  ip        String @default("")
  ua        String @default("")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginAttempt {
  id BigInt @id @default(autoincrement())
  key String @map("key")
  at BigInt

  @@index([key, at])
  @@map("login_attempts")
}

model Document {
  collection String @map("coll")
  id         String
  data       Json
  updatedAt  BigInt @map("updated_at")
  updatedBy  String? @map("updated_by")

  @@id([collection, id])
  @@map("docs")
}

model Asset {
  id             String  @id
  owner          String?
  mime           String
  size           Int
  name           String?
  sha256         String?
  clientId       String? @map("client_id")
  remotePath     String? @map("remote_path")
  remoteEtag     String? @map("remote_etag")
  storageState   String  @default("local") @map("storage_state")
  storageError   String? @map("storage_error")
  lastVerifiedAt BigInt? @map("last_verified_at")
  createdAt      BigInt  @map("created_at")

  @@index([clientId])
  @@index([storageState])
  @@map("assets")
}

model ClientStorageBinding {
  clientId       String  @id @map("client_id")
  folderName     String  @map("folder_name")
  folderPath     String  @unique @map("folder_path")
  status         String  @default("active")
  lastVerifiedAt BigInt? @map("last_verified_at")
  lastError      String? @map("last_error")
  createdAt      BigInt  @map("created_at")
  updatedAt      BigInt  @map("updated_at")

  @@index([status])
  @@map("client_storage_bindings")
}

model Audit {
  id      BigInt @id @default(autoincrement())
  at      BigInt
  actor   String?
  action  String
  target  String?
  details Json?

  @@index([at])
  @@map("audit")
}

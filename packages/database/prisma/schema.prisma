generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id
  username       String    @unique
  name           String
  email          String    @default("")
  passHash       String    @map("pass_hash")
  role           String    @default("member")
  status         String    @default("active")
  mustChange     Boolean   @default(true) @map("must_change")
  sessionVersion Int       @default(1) @map("session_version")
  createdAt      BigInt    @map("created_at")
  lastLogin      BigInt?   @map("last_login")
  memberId       String    @default("") @map("member_id")
  sessions       Session[]
  profilePhoto   UserProfilePhoto?

  @@map("users")
}

model Session {
  idHash    String @id @map("id_hash")
  userId    String @map("user_id")
  ver       Int
  createdAt BigInt @map("created_at")
  lastSeen  BigInt @map("last_seen")
  expiresAt BigInt @map("expires_at")
  ip        String @default("")
  ua        String @default("")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginAttempt {
  id BigInt @id @default(autoincrement())
  key String @map("key")
  at BigInt

  @@index([key, at])
  @@map("login_attempts")
}

model Document {
  collection String @map("coll")
  id         String
  data       Json
  updatedAt  BigInt @map("updated_at")
  updatedBy  String? @map("updated_by")

  @@id([collection, id])
  @@map("docs")
}

model Asset {
  id             String  @id
  owner          String?
  mime           String
  size           Int
  name           String?
  sha256         String?
  clientId       String? @map("client_id")
  remotePath     String? @map("remote_path")
  remoteEtag     String? @map("remote_etag")
  storageState   String  @default("local") @map("storage_state")
  storageError   String? @map("storage_error")
  lastVerifiedAt BigInt? @map("last_verified_at")
  createdAt      BigInt  @map("created_at")

  @@index([clientId])
  @@index([storageState])
  @@map("assets")
}

model ClientStorageBinding {
  clientId       String  @id @map("client_id")
  folderName     String  @map("folder_name")
  folderPath     String  @unique @map("folder_path")
  status         String  @default("active")
  lastVerifiedAt BigInt? @map("last_verified_at")
  lastError      String? @map("last_error")
  createdAt      BigInt  @map("created_at")
  updatedAt      BigInt  @map("updated_at")

  @@index([status])
  @@map("client_storage_bindings")
}

model Audit {
  id      BigInt @id @default(autoincrement())
  at      BigInt
  actor   String?
  action  String
  target  String?
  details Json?

  @@index([at])
  @@map("audit")
}

/**
 * Link externo de aprovação: somente o SHA-256 do token é persistido.
 * O snapshot congela exatamente o conteúdo compartilhado com o cliente.
 */
model ClientApproval {
  id          String  @id
  tokenHash   String  @unique @map("token_hash")
  kind        String
  targetId    String  @map("target_id")
  clientId    String  @map("client_id")
  title       String
  snapshot    Json
  status      String  @default("pending")
  requestedBy String  @map("requested_by")
  sourceUpdatedAt BigInt @map("source_updated_at")
  createdAt   BigInt  @map("created_at")
  expiresAt   BigInt  @map("expires_at")
  decidedAt   BigInt? @map("decided_at")
  decidedBy   String? @map("decided_by")
  comment     String?
  revokedAt   BigInt? @map("revoked_at")

  @@index([kind, targetId, createdAt])
  @@index([clientId, createdAt])
  @@map("client_approvals")
}

/** Uma foto por conta. Imagem JPEG compactada e armazenada exclusivamente no PostgreSQL. */
model UserProfilePhoto {
  userId    String @id @map("user_id")
  image     Bytes
  mime      String @default("image/jpeg")
  size      Int
  updatedAt BigInt @map("updated_at")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile_photos")
}

/** Eventos imutáveis de presença; horários são gravados pelo PostgreSQL em UTC. */
model PresenceEvent {
  id      BigInt   @id @default(autoincrement())
  userId  String   @map("user_id")
  day     String
  status  String
  reason  String   @default("")
  at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, at])
  @@index([day, at])
  @@map("presence_event")
}

/** Estado atual por conta, sem duplicação de relógios entre navegadores. */
model PresenceCurrent {
  userId String   @id @map("user_id")
  day    String
  status String
  reason String   @default("")
  since  DateTime @default(now()) @db.Timestamptz(6)

  @@map("presence_current")
}

model PresenceConfig {
  key   String @id
  value Int

  @@map("presence_config")
}

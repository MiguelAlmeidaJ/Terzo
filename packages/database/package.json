{
  "name": "@terzo/database",
  "version": "3.0.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate --config prisma.config.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "migrate:status": "prisma migrate status --config prisma.config.ts",
    "migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "studio": "prisma studio --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3"
  }
}

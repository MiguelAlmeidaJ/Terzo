{
  "name": "terzo-selfhost",
  "version": "2.0.0",
  "private": true,
  "workspaces": ["api", "web"],
  "scripts": {
    "dev": "npm run dev --workspace api & npm run dev --workspace web",
    "generate:legacy": "node scripts/generate-legacy.mjs",
    "prisma:generate": "npm run prisma:generate --workspace api",
    "prebuild": "npm run generate:legacy",
    "build": "npm run build --workspace api && npm run build --workspace web",
    "typecheck": "npm run typecheck --workspace api && npm run typecheck --workspace web",
    "prisma:deploy:local": "npm run prisma:deploy --workspace api",
    "db:migrate": "npm run prisma:deploy --workspace api",
    "db:sync-password": "node scripts/postgres-sync-password.mjs",
    "db:backup": "bash scripts/backup.sh",
    "verify:local": "node scripts/verify-local.mjs",
    "nextcloud:migrate": "node scripts/nextcloud-migrate.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 startOrReload ecosystem.config.cjs --update-env",
    "pm2:logs": "pm2 logs terzo-web terzo-api"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "prisma": "^7.10.1"
  }
}
